                      if (ok) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(
                            content: Text(
                                'Notiser aktiverade på den här enheten! 🔔'),
                            backgroundColor: Color(0xFF6BAE75),
