<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Besök hos Noomi 💜</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="container">

    <!-- ─── 0. Laddning & Felvyer ─── -->
    <div id="view-loading" class="spinner-container">
      <div class="spinner"></div>
      <p>Hämtar tider och dagsläge… 🫶</p>
    </div>

    <div id="view-error" class="error-card hidden">
      <h3>Kunde inte hämta tiderna</h3>
      <p id="error-message">Kontrollera din internetanslutning och försök igen.</p>
      <button type="button" id="btn-retry" class="btn-primary" style="margin-top: 14px;">Försök igen</button>
    </div>

    <div id="view-invalid-token" class="card hidden" style="text-align: center; padding: 30px 20px;">
      <div style="font-size: 40px; margin-bottom: 12px;">💜</div>
      <h2>Länken verkar inte stämma</h2>
      <p style="color: var(--text-muted); margin-top: 8px;">
        Be familjen skicka en ny länk så att du kan se lediga tider.
      </p>
    </div>

    <!-- ─── 1. Vy: Start / Tillgänglighet ─── -->
    <div id="view-start" class="hidden">
      <header>
        <h1>Besök hos <span id="person-first-name">Noomi</span> 💜</h1>
        <p class="subtitle">Säg till när du kommer, så vet familjen.</p>
        <!-- medvetet familjespecifikt -->
        <p class="visit-rule-notice">Just nu tar träningen mycket kraft — därför ett sällskap per dag och besök på högst en timme.</p>
      </header>

      <!-- Flytt-läge indikator om aktiv -->
      <div id="move-mode-banner" class="move-banner hidden">
        <span>🔄 Välj ny ankomsttid för ditt besök</span>
        <button type="button" id="btn-cancel-move" class="btn-back" style="margin: 0; color: #1B4F72;">Avbryt</button>
      </div>

      <!-- Dagens läge (visas endast vid gult/rött) -->
      <div id="today-banner" class="status-banner hidden">
        <div class="status-icon" id="today-icon">💛</div>
        <div id="today-text"></div>
      </div>

      <!-- medvetet familjespecifikt -->
      <!-- TODO: verifiera att nålen hamnar på hus T1 — annars ersätt med delningslänk från Google Maps / Apple Kartor -->
      <details class="directions-details">
        <summary class="directions-summary">📍 Hitta hit — adress & hur man kommer in</summary>
