                  _openStadzonerSeeder(context, familyId);
                } else if (v == 'stadskapet_guide') {
                  _openStadskapetGuide(context, familyId);
                }
              },
              itemBuilder: (ctx) => const [
                PopupMenuItem(
                  value: 'seed_stadzoner',
