                  _imageBytes!,
                  height: 180,
                  width: 240,
                  fit: BoxFit.cover,
                ),
              ),
            const SizedBox(height: 28),
            CircularProgressIndicator(color: dayColor),
            const SizedBox(height: 20),
            const Text(
              'Läser schemat… 🔍',
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
