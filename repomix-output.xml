class FamilyMemberAvatar extends StatelessWidget {
  final UserModel member;
  final double size;
  final double borderWidth;
  final Color? presenceColor;

  const FamilyMemberAvatar({
    super.key,
    required this.member,
    this.size = 48,
    this.borderWidth = 2.5,
