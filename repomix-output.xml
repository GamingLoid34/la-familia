        children: [
          Expanded(
            child: Text(
              'Sysslor',
              style: TextStyle(
                fontSize: 28,
                fontWeight: FontWeight.bold,
                color: textColor,
              ),
            ),
          ),
          IconButton(
            tooltip: 'Statistik',
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute<void>(
                  builder: (_) => const ChoreStatsPage(),
                ),
              );
            },
            icon: Icon(Icons.bar_chart_rounded, color: textColor),
