  String _timeGreeting() {
    final hour = DateTime.now().hour;
    if (hour >= 5 && hour < 10) return 'God morgon';
    if (hour >= 10 && hour < 12) return 'God förmiddag';
    if (hour >= 12 && hour < 18) return 'God eftermiddag';
    if (hour >= 18 && hour < 23) return 'God kväll';
    return 'God natt';
  }

