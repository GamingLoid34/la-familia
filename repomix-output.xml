  border-radius: 12px;
  padding: 12px 14px;
  font-size: 15px;
  font-weight: 600;
  color: #7D6608;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  line-height: 1.45;
}

.door-icon {
  font-size: 20px;
  line-height: 1;
  flex-shrink: 0;
}

.directions-embedded {
  background: #F8F9FA;
  border: 1px solid var(--border-light);
  border-radius: 14px;
  padding: 16px;
  margin: 16px 0;
}

/* ─── Hitta anmälan ─── */
.find-link-container {
  text-align: center;
  margin-top: 18px;
  margin-bottom: 8px;
}

.link-discrete {
  background: none;
  border: none;
  color: var(--primary);
  font-size: 15px;
  font-weight: 600;
  text-decoration: underline;
  cursor: pointer;
  padding: 8px 12px;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.link-discrete:hover {
  color: var(--primary-dark);
}

.found-booking-card {
  background: #F8F9FA;
  border: 1px solid var(--border-light);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 12px;
}

.found-booking-title {
