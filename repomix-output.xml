  String _formatBookingDate(String dateStr) {
    final d = parseDate(dateStr);
    if (d == null) return dateStr;
    try {
      return DateFormat('E d/M', 'sv').format(d);
    } catch (_) {
      return '${d.day}/${d.month}';
    }
  }
}
