                  : (transport == 'hamtas' ? '🤝 ' : '');

              final canEdit = user != null &&
                  (user.isParent ||
                      eventIncludesPerson(d, uid: user.uid, name: user.name) ||
                      eventHasNoPersons(d));

              return ActionChip(
                avatar: Text(piktogram, style: const TextStyle(fontSize: 16)),
