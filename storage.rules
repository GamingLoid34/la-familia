rules_version = '2';
// FIREBASE-PROJEKT la-familia-5d9f5 — betjänar ENDAST La Familia.
// (My Mirai-rester avvecklade 2026-09-08; flyttas till eget projekt senare.)
// Denna fil är enda sanningen. Deploy:
//   firebase deploy --only storage --project=la-familia-5d9f5
service firebase.storage {
  match /b/{bucket}/o {
    function isAuth() {
      return request.auth != null;
    }
    function myUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function myFamilyId() {
      return myUserDoc().get('familyId', '');
    }
    function iAmParent() {
      return myUserDoc().get('role', '') == 'parent'
          || myUserDoc().get('role', '') == 'admin';
    }

    // ── Läxunderlag (BEFINTLIG — beteendet oförändrat) ──
    match /families/{familyId}/homework/{homeworkId}/{fileName} {
      allow read: if isAuth() && myFamilyId() == familyId;
      allow write: if isAuth() && myFamilyId() == familyId
        && request.resource.size < 30 * 1024 * 1024;
    }

    // ── Storskärmsfoton (NY — FAS 4.5) ──
    match /families/{familyId}/display_photos/{photoId} {
      allow read: if isAuth() && myFamilyId() == familyId;
      allow create: if isAuth() && myFamilyId() == familyId && iAmParent()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && myFamilyId() == familyId && iAmParent();
      allow update: if false;
    }

    // ── Medlemsavatarer ──
    // Sökvägen är user_avatars/{uid}.jpg i båda klienterna. Bilden hör till den familj som
    // ägarens users-dokument pekar på.
    //
    // U-09 (beslut B-06): förut fick alla inloggade läsa alla avatarer, och en förälder i
    // VILKEN familj som helst skriva över och ta bort dem. Nu läses de bara av ägaren och den
    // egna familjen, och skrivs bara av ägaren eller en förälder i samma familj.
    //
    // Saknas ägarens users-dokument misslyckas firestore.get(), och allt utom ägarens egen
    // åtkomst nekas. Ägarens gren står först, så den prövas utan uppslag.
    function isAvatarFile(fileName) {
      return fileName.matches('[A-Za-z0-9_-]+[.]jpg');
    }
    function isOwnAvatar(fileName) {
      return fileName == request.auth.uid + '.jpg';
    }
    function avatarFamilyId(fileName) {
      return firestore.get(/databases/(default)/documents/users/$(fileName.split('[.]')[0]))
        .data.get('familyId', '');
    }
    function inAvatarFamily(fileName) {
      return myFamilyId() is string && myFamilyId() != ''
        && avatarFamilyId(fileName) == myFamilyId();
    }
    function mayWriteAvatar(fileName) {
      return isOwnAvatar(fileName) || (iAmParent() && inAvatarFamily(fileName));
    }

    match /user_avatars/{fileName} {
      allow read: if isAuth() && isAvatarFile(fileName)
        && (isOwnAvatar(fileName) || inAvatarFamily(fileName));
      allow create, update: if isAuth() && isAvatarFile(fileName)
        && mayWriteAvatar(fileName)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && isAvatarFile(fileName) && mayWriteAvatar(fileName);
    }

    // ── Matsedeluppladdningar (NY — Android-porten, Fas 12) ──
    // Klienten laddar upp bild/PDF hit i stället för att skicka ~11 MB
    // base64 i callable-payloaden; parseMenuDocument (storagePath-vägen)
    // läser filen och raderar den själv efteråt. Ingen läser den härifrån.
    match /menu_uploads/{familyId}/{fileName} {
      allow write: if isAuth() && myFamilyId() == familyId && iAmParent()
        && request.resource.size < 8 * 1024 * 1024;
      allow read: if false;
    }

    // Allt annat nekat — inklusive f.d. My Mirai documents/-sökvägen.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
